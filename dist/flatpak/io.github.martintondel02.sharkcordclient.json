{
  "app-id": "io.github.martintondel02.sharkcordclient",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "24.08",
  "sdk": "org.freedesktop.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.rust-stable"
  ],
  "command": "sharkcord-desktop",
  "finish-args": [
    "--share=network",
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--device=dri",
    "--socket=pulseaudio",
    "--talk-name=org.freedesktop.Notifications",
    "--filesystem=xdg-download:ro"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin",
    "env": {
      "CARGO_HOME": "/run/build/sharkcordclient/cargo",
      "RUST_BACKTRACE": "1",
      "CARGO_REGISTRIES_CRATES_IO_PROTOCOL": "sparse"
    },
    "build-args": [
      "--share=network"
    ]
  },
  "cleanup": [
    "/include",
    "/lib/pkgconfig",
    "/share/doc",
    "/share/man"
  ],
  "modules": [
    {
      "name": "sharkcordclient",
      "buildsystem": "simple",
      "build-commands": [
        "cargo build --release --bin sharkcord-desktop --offline || cargo build --release --bin sharkcord-desktop",
        "install -Dm755 target/release/sharkcord-desktop /app/bin/sharkcord-desktop",
        "install -Dm644 dist/sharkcordclient.desktop /app/share/applications/io.github.martintondel02.sharkcordclient.desktop",
        "install -Dm644 dist/sharkcordclient.svg /app/share/icons/hicolor/scalable/apps/sharkcordclient.svg",
        "install -Dm644 dist/sharkcordclient.metainfo.xml /app/share/metainfo/io.github.martintondel02.sharkcordclient.metainfo.xml"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "..",
          "dest": "sharkcordclient"
        },
        {
          "type": "archive",
          "path": "vendor.tar.gz",
          "dest": "sharkcordclient/vendor",
          "comment": "Generated by scripts/build-flatpak.sh (cargo vendor). Provides offline crate sources."
        }
      ],
      "cleanup-platform": ["/bin/cargo", "/bin/rustc"]
    }
  ]
}